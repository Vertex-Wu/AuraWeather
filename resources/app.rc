#include <windows.h>

101 ICON "icon.ico"
200 RCDATA "ca-bundle.crt"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,5,0
PRODUCTVERSION 2,0,5,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "AURA Weather"
            VALUE "FileDescription", "AURA 天气 - 独立天气应用"
            VALUE "FileVersion", "2.0.5.0"
            VALUE "InternalName", "AuraWeather"
            VALUE "OriginalFilename", "AuraWeather.exe"
            VALUE "ProductName", "AURA 天气"
            VALUE "ProductVersion", "2.0.5.0"
            VALUE "LegalCopyright", "Weather data: MET Norway, Open-Meteo, NASA GIBS"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END



